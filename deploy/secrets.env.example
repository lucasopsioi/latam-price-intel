# ============================================================================
#  拉美竞品情报中枢 —— 密钥（systemd EnvironmentFile）
#
#  安装到 /etc/latam-hub/secrets.env，权限 0600 root:root。
#  改完必须重启才生效：sudo systemctl restart latam-hub
#
#  ★ 命名规则：设置页里的 key 全大写、加 LATAM_SECRET_ 前缀。
#    app/db.py 的 get_setting() **优先读这里**，读不到才查 intel.db。
#    所以密钥可以一条都不落库 —— 备份/传输 intel.db 时不再带着密钥走。
#
#  ★ 副作用要知道：用环境变量提供的 Key，在设置页里改不动
#    （改了会写进库，但读取时仍被环境变量盖住）。设置页会把这类条目
#    标成 source=env，不会骗你说"未设置"。要改就改这个文件。
#
#  ★ 值不要加引号。systemd 的 EnvironmentFile 会把引号当成值的一部分。
#    正确：LATAM_SECRET_MINIMAX_API_KEY=sk-abc123
#    错误：LATAM_SECRET_MINIMAX_API_KEY="sk-abc123"
# ============================================================================

# ---- MiniMax：清洗 / 价格审计 / 情报 / 规格补全 四个 Agent 共用 ----
# 不配也能跑，但会退回规则模式：灰色地带的价格判不了、新闻不翻译不打分、
# 页面文本兜底抽取不可用。
LATAM_SECRET_MINIMAX_API_KEY=在这里填你的_MiniMax_Key

# ---- MercadoLibre：六国最大电商，阿根廷唯一渠道 ----
# developers.mercadolibre.com 免费注册拿 token。
# 不配的话 ML 会如实报 login_wall（游客访问必被 302 拦），阿根廷直接没数据。
LATAM_SECRET_MELI_ACCESS_TOKEN=

# ---- Telegram 简报与告警 ----
LATAM_SECRET_TELEGRAM_BOT_TOKEN=
LATAM_SECRET_TELEGRAM_CHAT_ID=

# ---- 可选 ----
# 出口代理。阿里云新加坡是数据中心 IP 段，若 doctor 体检显示大量渠道
# 从"可达"退化成"被拦"，在这里挂住宅代理。留空 = 直连。
LATAM_SECRET_PROXY=

# X/Twitter 情报源，不配则跳过该来源。
LATAM_SECRET_X_BEARER_TOKEN=
